# Configuration de la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=secure_auth_db
DB_USER=secure_auth_user
DB_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION

# Tests MySQL uniquement : base existante dédiée, nom commençant par test_
# TEST_DB_NAME=test_secure_auth

# Session API Flask
SESSION_SECRET_KEY=GENEREZ_UNE_CLE_SECRETE_FORTE_32_BYTES
SESSION_COOKIE_SECURE=false
APP_PUBLIC_BASE_URL=http://127.0.0.1:5173

# Envoi des liens de réinitialisation et alertes de sécurité
# Pour Gmail : smtp.gmail.com, port 587, TLS activé, mot de passe d'application.
# Pour les tests locaux : docker compose -f docker-compose.mailpit.yml up -d,
# puis SMTP_HOST=127.0.0.1, SMTP_PORT=1025 et SMTP_USE_TLS=false.
NOTIFICATION_BACKEND=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
NOTIFICATION_EMAIL_FROM=
PASSWORD_RESET_URL_BASE=http://127.0.0.1:5173/password-reset/confirm

# Configuration MFA
TOTP_ISSUER=SecureAuth ASVS

# Instructions :
# 1. Copiez ce fichier en .env (Linux/macOS : cp .env.example .env)
# 2. Générez une clé secrète : python3 -c "import secrets; print(secrets.token_hex(32))"
# 3. Remplacez les valeurs par vos propres configurations
# 4. Chargez les variables : source .env

# Configuration de la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=secure_auth_db
DB_USER=secure_auth_user
DB_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION

# Tests MySQL uniquement : base existante dédiée, nom commençant par test_
# TEST_DB_NAME=test_secure_auth

# Session FastAPI / Starlette
SESSION_SECRET_KEY=GENEREZ_UNE_CLE_SECRETE_FORTE_32_BYTES
SESSION_COOKIE_SECURE=false

# Configuration MFA
TOTP_ISSUER=SecureAuth ASVS

# Instructions :
# 1. Copiez ce fichier en .env (PowerShell : Copy-Item .env.example .env)
# 2. Générez une clé secrète : python3 -c "import secrets; print(secrets.token_hex(32))"
# 3. Remplacez les valeurs par vos propres configurations
# 4. Chargez les variables : source .env
